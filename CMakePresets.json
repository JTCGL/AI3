{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-debug",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/AI3/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "termux-clang-debug",
      "inherits": "base-debug",
      "cacheVariables": {
        "AI3_TERMUX": "ON",
        "CMAKE_C_FLAGS": "-U__ANDROID__",
        "CMAKE_CXX_FLAGS": "-U__ANDROID__",
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_CXX_COMPILER": "clang++",
        "SDL_KMSDRM": "OFF",
        "SDL_WAYLAND": "OFF",
        "SDL_X11": "ON"
      }
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "base-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "headless-debug",
      "inherits": "base-debug",
      "cacheVariables": {
        "AI3_HEADLESS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "termux-clang-debug",
      "configurePreset": "termux-clang-debug",
      "jobs": 1
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "termux-clang-debug",
      "configurePreset": "termux-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-debug",
      "configurePreset": "headless-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
